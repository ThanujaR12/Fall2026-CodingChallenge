# Port the API listens on (the client expects 4000 by default).
PORT=4000
# MongoDB Atlas connection string: Atlas → Database → Connect → Drivers (allow your IP under Network Access).
MONGODB_URI=
# Free Pixabay API key: sign in at https://pixabay.com/api/docs/ and copy the key shown there.
PIXABAY_API_KEY=
# Secret that signs sign-in sessions (at least 16 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional: Google OAuth client id (public, ends in .apps.googleusercontent.com) for
# "Continue with Google". Leave empty to hide Google sign-in.
GOOGLE_CLIENT_ID=230691522876-lrk465hn7t29v5vhfqd65opkbkae5ne0.apps.googleusercontent.com
# Origin of the web client allowed by CORS (Vite dev server default).
CLIENT_ORIGIN=http://localhost:5173

# Optional: Anthropic API key for "Search with a photo" (brands, printed text, subjects).
# Get one at https://console.anthropic.com. Leave empty to use on-device recognition only.
ANTHROPIC_API_KEY=
